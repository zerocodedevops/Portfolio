{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/paginas-web-pymes-autonomos",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/desarrollo-web-pymes-madrid",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/desarrollo-web-pymes-madrid/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/disenador-web-freelance-madrid",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/disenador-web-freelance-madrid/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/tech",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/blog/**",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "destination": "/sitemap.xml"
      },
      {
        "source": "/robots.txt",
        "destination": "/robots.txt"
      },
      {
        "source": "/zerodelay",
        "destination": "/zerodelay/index.html"
      },
      {
        "source": "/zerodelay/**",
        "destination": "/zerodelay/index.html"
      },
      {
        "source": "/reformas",
        "destination": "/reformas/index.html"
      },
      {
        "source": "/reformas/**",
        "destination": "/reformas/index.html"
      },
      {
        "source": "/devops-shop",
        "destination": "/devops-shop/index.html"
      },
      {
        "source": "/devops-shop/**",
        "destination": "/devops-shop/index.html"
      },
      {
        "source": "/proyectos/reformas",
        "destination": "/index.html"
      },
      {
        "source": "/proyectos/reformas/**",
        "destination": "/index.html"
      },
      {
        "source": "/proyectos/zero-delay",
        "destination": "/index.html"
      },
      {
        "source": "/proyectos/zero-delay/**",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; script-src 'self' https://www.googletagmanager.com https://apis.google.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://r2cdn.perplexity.ai; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://www.google-analytics.com https://www.googletagmanager.com https://coin-images.coingecko.com https://vwdsnolwerskjjhmrsut.supabase.co https://images.unsplash.com https://images.pexels.com https://res.cloudinary.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebasestorage.googleapis.com https://api.emailjs.com https://www.googletagmanager.com https://api.coingecko.com https://pro-api.coingecko.com https://coin-images.coingecko.com https://api.stripe.com https://m.stripe.network wss://stream.binance.com:443 https://vwdsnolwerskjjhmrsut.supabase.co wss://vwdsnolwerskjjhmrsut.supabase.co; frame-src 'self' https://zerocode-devops.com https://zerocode-devops.web.app https://www.googletagmanager.com https://accounts.google.com https://js.stripe.com https://hooks.stripe.com;"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=()"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "services/dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "services/dataconnect"
  }
}
