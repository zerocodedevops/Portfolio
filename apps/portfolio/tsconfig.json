{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@zerovanity/*": [
        "../zerovanity/src/*"
      ],
      "@crypto/*": [
        "../crypto/*"
      ],
      "@ecommerce/*": [
        "../ecommerce/*"
      ],
      "@ecommerce-shop/*": [
        "../ecommerce-shop/*"
      ],
      "@analytics/*": [
        "../analytics-dashboard/*"
      ],
      "@shipping-service/*": [
        "../shipping-service/src/*"
      ],
      "@home-renovation/*": [
        "../home-renovation/*"
      ],
      "@salon/*": [
        "../zerovanity/src/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "apps"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../home-renovation/app/routes.ts",
    "../home-renovation/react-router.config.ts",
    "../home-renovation/vite.config.ts",
    "../ecommerce-shop/vite.config.ts",
    "../shipping-service/vite.config.ts",
    "../ecommerce-shop/node_modules",
    "../shipping-service/node_modules",
    "../shipping-service/dist"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}