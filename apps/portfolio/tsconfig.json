{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@zerovanity/*": [
        "../zerovanity/src/*"
      ],
      "@crypto/*": [
        "../crypto/*"
      ],
      "@ecommerce/*": [
        "../ecommerce/*"
      ],
      "@ecommerce-shop/*": [
        "../ecommerce-shop/*"
      ],
      "@analytics/*": [
        "../analytics/*"
      ],
      "@shipping-service/*": [
        "../zerodelay/src/*"
      ],
      "@home-renovation/*": [
        "../zero-chaos/*"
      ],
      "@zerodelay/*": [
        "../zerodelay/src/*"
      ],
      "@zeroshop/*": [
        "../zeroshop/src/*"
      ],
      "@zero-chaos/*": [
        "../zero-chaos/*"
      ],
      "@salon/*": [
        "../zerovanity/src/*"
      ]
    },
  },
  "include": [
    "src",
    "tests",
    "apps"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../zero-chaos/app/routes.ts",
    "../zero-chaos/react-router.config.ts",
    "../zero-chaos/vite.config.ts",
    "../zerodelay/vite.config.ts",
    "../zerodelay/node_modules",
    "../zerodelay/dist"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
