{
  "name": "zerocode-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "qs": "6.16.0",
    "concurrently": {
      "shell-quote": "1.12.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:portfolio": "turbo run dev --filter=portfolio-app",
    "build": "npm run build:all && npm run copy:all && node scripts/sync-csp-inline-script-hashes.mjs firebase.json dist/reformas && node scripts/sync-csp-inline-script-hashes.mjs apps/zero-chaos/firebase.json apps/zero-chaos/build/client",
    "build:all": "turbo run build",
    "copy:all": "node scripts/copy-all.mjs",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "type-check": "npm run type-check --workspace=portfolio-app",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules dist",
    "db:migrate": "supabase migration up",
    "db:seed": "psql -f database/seeds/initial_data.sql",
    "sync": "pwsh scripts/sync.ps1",
    "push-all": "pwsh scripts/push-all.ps1",
    "export-session": "pwsh scripts/export-session.ps1",
    "import-session": "pwsh scripts/import-session.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "packageManager": "npm@11.12.0"
}
