{
  "name": "zerocode-portfolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:all": "turbo run dev",
    "build": "npm run build:all",
    "build:all": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules dist",
    "db:migrate": "supabase migration up",
    "db:seed": "psql -f database/seeds/initial_data.sql",
    "sync": "pwsh scripts/sync.ps1",
    "push-all": "pwsh scripts/push-all.ps1",
    "export-session": "pwsh scripts/export-session.ps1",
    "import-session": "pwsh scripts/import-session.ps1"
  },
  "dependencies": {},
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vercel/node": "^5.5.16",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^5.11.0",
    "sharp": "^0.34.5",
    "shx": "^0.4.0",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  },
  "packageManager": "npm@11.8.0"
}