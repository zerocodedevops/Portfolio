# -----------------
# Global / Portfolio
# -----------------
# EmailJS configuration for contact forms
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key

# In the EmailJS template settings, enable reCAPTCHA v2 and set the Google secret key there.
# Never put the reCAPTCHA secret key in a VITE_ variable or in this file.

