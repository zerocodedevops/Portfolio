{
	"compilerOptions": {
		"target": "ES2021",
		"useDefineForClassFields": true,
		"lib": [
			"ES2021",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"src/*"
			],
			"@zerovanity/*": [
				"apps/zerovanity/src/*"
			],
			"@crypto/*": [
				"apps/crypto/*"
			],
			"@ecommerce/*": [
				"apps/ecommerce/*"
			],
			"@analytics/*": [
				"apps/analytics/*"
			],
			"@zerodelay/*": [
				"apps/zerodelay/src/*"
			],
			"@zero-chaos/*": [
				"apps/zero-chaos/*"
			],
			"@salon/*": [
				"apps/zerovanity/src/*"
			]
		}
	},
	"include": [
		"src",
		"tests",
		"apps"
	],
	"exclude": [
		"node_modules",
		"dist",
		"apps/zerovanity/src/app",
		"apps/zerovanity/src/middleware.ts",
		"apps/zerovanity/src/i18n",
		"apps/zerovanity/src/lib/prisma.ts",
		"apps/zero-chaos/app/routes.ts",
		"apps/zero-chaos/react-router.config.ts",
		"apps/zero-chaos/vite.config.ts",
		"apps/devops-shop/vite.config.ts",
		"apps/zerodelay/vite.config.ts",
		"apps/devops-shop/node_modules",
		"apps/zerodelay/node_modules",
		"apps/zerodelay/dist"
	],
	"references": [
		{
			"path": "./tsconfig.node.json"
		}
	]
}